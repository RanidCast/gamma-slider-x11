pkgname=gamma-slider-x11
pkgver=1.2.0
pkgrel=1
pkgdesc="Tray app for screen color temperature on X11 and KDE Plasma Wayland"
arch=('x86_64')
url="https://github.com/RanidCast/gamma-slider-x11"
license=('GPL-3.0-or-later')
depends=('python' 'python-pyqt5' 'libx11' 'libxcb')
optdepends=('python-pyqt6: use PyQt6 instead of PyQt5'
            'python-dbus: KDE Wayland global shortcuts')
source=("$pkgname-v$pkgver-source.zip::$url/releases/download/v$pkgver/$pkgname-v$pkgver-source.zip")
sha256sums=('606e549d31057a205835620c101a8abe103dfc19e98332d2f5a80552e38981e2')

package() {
    install -Dm755 "$srcdir/app.py" "$pkgdir/opt/$pkgname/app.py"
    install -Dm755 "$srcdir/install.sh" "$pkgdir/opt/$pkgname/install.sh"
    for file in backend_linux.py platform_support.py hotkeys.py ipc.py; do
        install -Dm644 "$srcdir/$file" "$pkgdir/opt/$pkgname/$file"
    done
    install -Dm644 "$srcdir/gamma_slider_icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/gamma-slider-x11.svg"

    install -Dm755 /dev/stdin "$pkgdir/usr/bin/gamma-slider-x11" <<'EOF'
#!/usr/bin/env bash
exec python3 /opt/gamma-slider-x11/app.py "$@"
EOF

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/gamma-slider-x11.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Gamma Slider X11
Comment=Change screen color temperature on X11
Exec=gamma-slider-x11
Icon=gamma-slider-x11
Terminal=false
Categories=Utility;Settings;
EOF
}
